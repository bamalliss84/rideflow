# RideFlow local development environment.
# Copy to .env (scripts/dev-up.ps1 does this automatically). NEVER commit .env.
# All values below are development-only placeholders, not production secrets.

# Host port for the API container (8000 is often taken on Windows hosts)
API_PORT=8010

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010

# PostgreSQL / PostGIS (application role is NOT a superuser so row-level security applies)
POSTGRES_DB=rideflow
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-postgres-password
DB_HOST=db
DB_PORT=5432
DB_NAME=rideflow
DB_USER=rideflow_app
DB_PASSWORD=dev-app-password

# Redis (cache, throttling, channel layer)
REDIS_URL=redis://redis:6379/0

# JWT lifetimes (seconds)
JWT_ACCESS_SECONDS=900
JWT_REFRESH_SECONDS=1209600

# OTP: the dev adapter accepts this fixed code and logs it. Leave empty outside development.
OTP_PROVIDER=dev
OTP_DEV_CODE=000000

# Demo data (scripts/seed or `python manage.py seed_demo`)
DEMO_PLATFORM_ADMIN_PHONE=+967700000000
DEMO_PLATFORM_ADMIN_PASSWORD=change-me-local-only
# Set to 1 to load demo data automatically when the API container starts
SEED_DEMO_ON_START=0
